{
  "name": "winsur",
  "private": true,
  "version": "0.1.2",
  "description": "Winsur — multi-agent control surface for Windows",
  "author": "Suriya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suriya-z/winsur.git"
  },
  "homepage": "https://github.com/suriya-z/winsur",
  "bugs": {
    "url": "https://github.com/suriya-z/winsur/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.cjs\"",
    "test:e2e": "vite build && node --test --test-concurrency=1 \"test/e2e/**/*.e2e.cjs\"",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:1420 && electron .\"",
    "electron:start": "electron .",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "electron:build": "npm run icon && vite build && electron-builder --win --config.productName=Winsur",
    "dist": "npm run electron:build",
    "release": "npm run icon && vite build && electron-builder --win --config.productName=Winsur --publish always",
    "start": "npm run electron:dev",
    "free": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/free-ports.ps1",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "hooks:install": "node -e \"require('./electron/hooks.cjs').autoInstallOnLaunch()\""
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.winsur.app",
    "productName": "Winsur",
    "copyright": "Copyright © 2026 Suriya",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "suriya-z",
        "repo": "winsur",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "hooks",
        "to": "hooks"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Winsur"
    }
  }
}
